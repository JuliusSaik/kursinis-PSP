# Copy this file to .env and adjust the values. All values are optional.

PORT=3000
TIME_ZONE=Europe/Vilnius

# Fixes "today" for the business rules, so the design document scenarios can be replayed.
# Leave empty to use the real date.
APP_TODAY=2026-10-05

# mock: built-in keyword classifier, no API key needed.
# openai: real model through the OpenAI Chat Completions API.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
