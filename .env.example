# Copy this file to .env and adjust the values. Without .env the app starts with demo tenants and the mock AI.

PORT=3000
TIME_ZONE=Europe/Vilnius

# Fixes "today" for the business rules, so the design document scenarios can be replayed.
# Leave empty to use the real date (recommended with real Gmail accounts).
APP_TODAY=

# Signs the session cookie. Use a long random value outside local development.
SESSION_SECRET=change-me-to-a-long-random-string

# AI provider used for email analysis:
#   mock    built-in keyword classifier, no API key needed
#   gemini  Google Gemini (free tier available), needs GEMINI_API_KEY from https://aistudio.google.com/apikey
#   claude  Anthropic Claude, needs ANTHROPIC_API_KEY from https://console.anthropic.com
AI_PROVIDER=gemini
# Optional model override; empty uses the provider default (gemini-3.5-flash-lite, claude-haiku-5-5).
AI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Google sign-in (OAuth client of type "Web application" in Google Cloud Console).
# Leave empty to hide the Google button and use only the demo tenants.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated Google accounts that are registered as tenants. Other accounts are refused.
GOOGLE_ACCOUNTS=
# Address the browser uses; the OAuth redirect URI is PUBLIC_URL/auth/google/callback.
# Use http://localhost:5173 while running the Vite dev server.
PUBLIC_URL=http://localhost:3000

# Shows the demo tenant buttons on the login page (mock inbox and tasks).
DEMO_LOGIN=true
