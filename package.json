{
  "name": "piemail",
  "version": "0.2.0",
  "description": "PiEmail: important email triage and Google Tasks reminders (prototype)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/server.js",
    "reset": "node -e \"require('fs').rmSync('data/runtime', { recursive: true, force: true })\"",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
